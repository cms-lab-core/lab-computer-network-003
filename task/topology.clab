name: lab-computer-network-003

topology:
  groups:
    hosts:
      kind: linux
      image: ghcr.io/nicolaka/netshoot:v0.16
  nodes:
    pc1:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - /bin/sh -c "ip link set dev eth1 address 02:00:00:00:03:01"
        - /bin/sh -c "ip link set dev eth1 up"
    pc2:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - /bin/sh -c "ip link set dev eth1 address 02:00:00:00:03:02"
        - /bin/sh -c "ip link set dev eth1 up"
  links:
    - endpoints: ["pc1:eth1", "pc2:eth1"]
